# ===================================
# SMARTPARKING ENVIRONMENT VARIABLES
# ===================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ===================================
# SEPAY CONFIGURATION (REQUIRED)
# ===================================
SEPAY_API_KEY=your-sepay-api-key-here
SEPAY_WEBHOOK_SECRET=your-32-character-webhook-secret-here

# ===================================
# JWT CONFIGURATION (REQUIRED)
# ===================================
JwtSettings__SecretKey=your-jwt-secret-key-minimum-32-characters

# ===================================
# DATABASE (Optional - can use appsettings)
# ===================================
# ConnectionStrings__DefaultConnection=Data Source=(Local);Initial Catalog=SmartParkingDB;User ID=sa;Password=yourpassword;TrustServerCertificate=True

# ===================================
# EMAIL (Optional - can use appsettings)
# ===================================
# EmailSettings__SmtpPassword=your-smtp-app-password

# ===================================
# VNPAY (Optional - can use appsettings)
# ===================================
# VnPay__HashSecret=your-vnpay-hash-secret

# ===================================
# GOOGLE OAUTH (Optional)
# ===================================
# GoogleOAuth__ClientSecret=your-google-client-secret

# ===================================
# CLOUDINARY (Optional - for image upload)
# ===================================
# CloudinarySettings__CloudName=your-cloud-name
# CloudinarySettings__ApiKey=your-api-key
# CloudinarySettings__ApiSecret=your-api-secret

# ===================================
# VNPAY PRODUCTION (Deploy)
# ===================================
# VnPay__TmnCode=your-merchant-code
# VnPay__HashSecret=your-hash-secret
# VnPay__ReturnUrl=https://yourdomain.com/api/payments/vnpay-callback
# VnPay__PaymentUrl=https://vnpayment.vn/paymentv2/vpcpay.html
