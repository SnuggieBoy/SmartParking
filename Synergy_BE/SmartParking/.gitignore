## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# NuGet Symbol Packages
*.snupkg

# NuGet package folders
**/[Pp]ackages/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# VS Code directories
.vscode/

# Mac files
.DS_Store

# Sensitive configuration files
**/appsettings.Development.json
**/appsettings.Production.json
**/*.secret.json

# Database files
*.mdf
*.ldf

# EF Core Migrations (optional - uncomment if you want to ignore)
# **/Migrations/

# Logs
logs/
*.log

# Test Results
TestResults/

# Backup files
*.bak
*.tmp

# EF Core Power Tools
efpt.config.json
