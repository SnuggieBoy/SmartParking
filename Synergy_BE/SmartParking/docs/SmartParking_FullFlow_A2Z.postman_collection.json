	"item": [
		{
			"name": "1. Auth - Đăng ký & Đăng nhập",
			"item": [
				{
					"name": "1.1 Login (CHẠY DAU TIEN - dung tai khoan co san)",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login"
					},
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Login User OK', function() { pm.response.to.have.status(200); });",
								"if (pm.response.code === 200) { try { var json = pm.response.json(); if (json.success && json.data) { if (json.data.accessToken) pm.collectionVariables.set('bearerToken', json.data.accessToken); if (json.data.userId) pm.collectionVariables.set('userId', json.data.userId); else if (json.data.user && json.data.user.userId) pm.collectionVariables.set('userId', json.data.user.userId); } } catch(e) {} }"
							],
							"type": "text/javascript"
						}
					}]
				},
				{
					"name": "1.1b Login as Owner",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testOwnerEmail}}\",\n  \"password\": \"{{testOwnerPassword}}\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login"
					},
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Login Owner OK', function() { pm.response.to.have.status(200); });",
								"if (pm.response.code === 200) { try { var json = pm.response.json(); if (json.success && json.data && json.data.accessToken) pm.collectionVariables.set('ownerBearerToken', json.data.accessToken); } catch(e) {} }"
							],
							"type": "text/javascript"
						}
					}]
				},
				{
					"name": "1.2 Register Request (Gui OTP - neu chua co tai khoan)",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"Nguyen Van Test\",\n  \"email\": \"{{testEmail}}\",\n  \"phone\": \"0901234567\",\n  \"password\": \"{{testPassword}}\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/register-request"
					},
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"if (pm.response.code !== 200) return;",
								"pm.test('Register OK', function() { pm.response.to.have.status(200); });"
							],
							"type": "text/javascript"
						}
					}]
				},
				{
					"name": "1.3 Verify OTP (lay OTP tu email roi nhap vao day)",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"otpCode\": \"123456\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/verify-otp"
					},
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"if (pm.response.code !== 200) return;",
								"try { var json = pm.response.json(); if (json.success && json.data) { if (json.data.accessToken) pm.collectionVariables.set('bearerToken', json.data.accessToken); if (json.data.userId) pm.collectionVariables.set('userId', json.data.userId); } } catch(e) {}"
							],
							"type": "text/javascript"
						}
					}]
				}
			]
		},
