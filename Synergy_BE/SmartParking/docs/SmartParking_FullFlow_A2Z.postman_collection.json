							{"key": "Authorization", "value": "Bearer {{bearerToken}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"licensePlate\": \"51A-{{$randomInt}}\",\n  \"vehicleType\": 1,\n  \"brand\": \"Toyota\",\n  \"model\": \"Camry\",\n  \"color\": \"Black\"\n}"
						},
						"url": "{{baseUrl}}/api/vehicles"
					},
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Add Vehicle OK', function() { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
								"if (pm.response.code === 200 || pm.response.code === 201) { try { var json = pm.response.json(); if (json.success && json.data && json.data.vehicleId) pm.collectionVariables.set('vehicleId', json.data.vehicleId); } catch(e) {} }"
