        },
        {
            "key": "vehicleId",
            "value": "",
            "type": "string"
        },
        {
            "key": "parkingLotId",
            "value": "",
            "type": "string"
        },
        {
            "key": "bookingId",
            "value": "",
            "type": "string"
        },
        {
            "key": "totalAmount",
            "value": "0",
            "type": "string"
        },
        {
            "key": "upgradeRequestId",
