{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(Local);Initial Catalog=SmartParkingDB;Persist Security Info=True;User ID=sa;Password=123456"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-min-32-characters-long-for-production",
