## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Environment variables (IMPORTANT: Never commit secrets!)
.env
.env.local
.env.*.local

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains Rider
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Sensitive configuration files (NEVER commit real secrets!)
**/appsettings.Production.json
**/appsettings.Development.json
**/*.secret.json
**/appsettings.*.local.json

# Database files
*.mdf
*.ldf

# Logs
logs/
*.log

# Test Results
TestResults/

# Backup files
*.bak
*.tmp
